{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kurobara.invalid/schemas/plays/command-response/1.0.0",
  "title": "PlayCommandResponse",
  "description": "Compiled Play preview or immutable Play revision and durable run receipt.",
  "type": "object",
  "additionalProperties": false,
  "required": ["action"],
  "properties": {
    "action": {
      "type": "string",
      "enum": ["preview", "approve", "start", "pause", "retire"]
    },
    "compilation": { "$ref": "#/$defs/compilation" },
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "issues": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "https://schemas.kurobara.invalid/schemas/gtm/context-command-response/1.0.0#/$defs/issue"
      }
    },
    "lifecycle": {
      "type": "string",
      "enum": [
        "draft",
        "validated",
        "previewed",
        "awaiting_approval",
        "approved",
        "active",
        "paused",
        "retired"
      ]
    },
    "play": {
      "$ref": "https://schemas.kurobara.invalid/schemas/plays/command-request/1.0.0#/$defs/play"
    },
    "requires_human_approval": { "type": "boolean" },
    "revision": { "$ref": "#/$defs/revision" },
    "run": { "$ref": "#/$defs/run" }
  },
  "oneOf": [
    {
      "type": "object",
      "required": [
        "action",
        "compilation",
        "fingerprint",
        "issues",
        "lifecycle",
        "play",
        "requires_human_approval"
      ],
      "properties": {
        "action": { "const": "preview" },
        "revision": false,
        "run": false
      }
    },
    {
      "type": "object",
      "required": ["action", "revision"],
      "properties": {
        "action": { "enum": ["approve", "pause", "retire"] },
        "compilation": false,
        "fingerprint": false,
        "issues": false,
        "lifecycle": false,
        "play": false,
        "requires_human_approval": false,
        "run": false
      }
    },
    {
      "type": "object",
      "required": ["action", "revision", "run"],
      "properties": {
        "action": { "const": "start" },
        "compilation": false,
        "fingerprint": false,
        "issues": false,
        "lifecycle": false,
        "play": false,
        "requires_human_approval": false
      }
    }
  ],
  "$defs": {
    "compilation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assumptions",
        "authority",
        "budget",
        "deadline_ms",
        "export_mode",
        "intention_hash",
        "stages"
      ],
      "properties": {
        "assumptions": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          }
        },
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": ["human_gates", "permissions"],
          "properties": {
            "human_gates": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255,
                "pattern": "^[a-z][a-z0-9_:-]*$"
              }
            },
            "permissions": {
              "type": "array",
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255,
                "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9-]*$"
              }
            }
          }
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["limit", "quoted_upper_bound", "unit"],
          "properties": {
            "limit": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1000000000000000
            },
            "quoted_upper_bound": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000000
            },
            "unit": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9._-]*$"
            }
          }
        },
        "deadline_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "export_mode": { "type": "string", "const": "no_send" },
        "intention_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "stages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["input_fingerprint", "operation_id", "ordinal"],
            "properties": {
              "capability": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255,
                "pattern": "^[a-z][a-z0-9.-]*$"
              },
              "input_fingerprint": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "operation_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255,
                "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
              },
              "ordinal": {
                "type": "integer",
                "minimum": 1,
                "maximum": 128
              }
            }
          }
        }
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compilation",
        "created_at_ms",
        "created_by_actor_id",
        "fingerprint",
        "lifecycle",
        "play",
        "play_id",
        "revision",
        "workspace_id"
      ],
      "properties": {
        "compilation": { "$ref": "#/$defs/compilation" },
        "created_at_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "created_by_actor_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "\\S"
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "lifecycle": {
          "type": "string",
          "enum": [
            "draft",
            "validated",
            "previewed",
            "awaiting_approval",
            "approved",
            "active",
            "paused",
            "retired"
          ]
        },
        "play": {
          "$ref": "https://schemas.kurobara.invalid/schemas/plays/command-request/1.0.0#/$defs/play"
        },
        "play_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "workspace_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "\\S"
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compilation",
        "created_at_ms",
        "idempotency_key",
        "play",
        "play_id",
        "play_revision",
        "run_id",
        "state",
        "workspace_id"
      ],
      "properties": {
        "compilation": { "$ref": "#/$defs/compilation" },
        "created_at_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "play": {
          "$ref": "https://schemas.kurobara.invalid/schemas/plays/command-request/1.0.0#/$defs/play"
        },
        "play_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "play_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "state": {
          "type": "string",
          "enum": [
            "queued",
            "running",
            "paused",
            "completed",
            "failed",
            "cancelled"
          ]
        },
        "workspace_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "\\S"
        }
      }
    }
  },
  "x-kurobara-schema-version": "1.0.0",
  "x-kurobara-owner": "application.gtm",
  "x-kurobara-data-classification": "confidential",
  "x-kurobara-redaction": "no-secrets-provider-neutral",
  "x-kurobara-publication-status": "local-development-only"
}
