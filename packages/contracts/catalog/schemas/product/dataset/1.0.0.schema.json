{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kurobara.invalid/schemas/product/dataset/1.0.0",
  "title": "Dataset",
  "description": "Stable canonical identity for a bounded local collection of records and fields within one workspace.",
  "type": "object",
  "additionalProperties": false,
  "required": ["dataset_id", "workspace_id", "name"],
  "properties": {
    "dataset_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "\\S"
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "\\S"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "\\S"
    }
  },
  "x-kurobara-schema-version": "1.0.0",
  "x-kurobara-owner": "product.datasets",
  "x-kurobara-data-classification": "internal",
  "x-kurobara-publication-status": "local-development-only"
}
