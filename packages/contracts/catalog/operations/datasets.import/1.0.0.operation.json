{
  "operation_id": "datasets.import",
  "operation_version": "1.0.0",
  "action_ref": "ImportDataset",
  "kind": "mutation",
  "auth_profile": "http-bearer",
  "idempotence": "required",
  "input_schema_id": "https://schemas.kurobara.invalid/schemas/datasets/import-request/1.0.0",
  "output_schema_id": "https://schemas.kurobara.invalid/schemas/datasets/import-response/1.0.0",
  "problem_codes": [
    "authentication-required",
    "authority-permission-missing",
    "authority-subject-mismatch",
    "dataset-import-conflict",
    "dataset-import-failed",
