{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kurobara.invalid/schemas/contacts/work-email-execution-query/1.0.0",
  "title": "ContactWorkEmailExecutionQuery",
  "description": "Internal ordered full-identity snapshots for selected work-email resolution or verification.",
  "type": "object",
  "additionalProperties": false,
  "oneOf": [
    {
      "type": "object",
      "required": ["operation_kind", "selected_contacts"],
      "properties": {
        "operation_kind": { "type": "string", "const": "resolve" },
        "selected_contacts": { "$ref": "#/$defs/resolveSelection" }
      }
    },
    {
      "type": "object",
      "required": ["operation_kind", "selected_contacts"],
      "properties": {
        "operation_kind": { "type": "string", "const": "verify" },
        "selected_contacts": { "$ref": "#/$defs/verifySelection" }
      }
    }
  ],
  "required": [
    "operation_kind",
    "result_kind",
    "selected_contacts",
    "source_dataset_id"
  ],
  "properties": {
    "operation_kind": {
      "type": "string",
      "enum": ["resolve", "verify"]
    },
    "result_kind": { "type": "string", "const": "contact_work_email" },
    "selected_contacts": {
      "oneOf": [
        { "$ref": "#/$defs/resolveSelection" },
        { "$ref": "#/$defs/verifySelection" }
      ]
    },
    "source_dataset_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "\\S"
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "department",
        "display_name",
        "identity_completeness",
        "job_title",
        "observed_at_ms",
        "organization_domain",
        "organization_id",
        "organization_name",
        "person_country_code",
        "profile_url",
        "seniority"
      ],
      "properties": {
        "department": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-z][a-z0-9._-]*$"
            }
          ]
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "\\S"
        },
        "identity_completeness": { "type": "string", "const": "full" },
        "job_title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "\\S"
        },
        "observed_at_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "organization_domain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
        },
        "organization_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "\\S"
        },
        "organization_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "\\S"
        },
        "person_country_code": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "string",
              "minLength": 2,
              "maxLength": 2,
              "pattern": "^[A-Z]{2}$"
            }
          ]
        },
        "profile_url": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "string",
              "format": "uri",
              "maxLength": 2048,
              "pattern": "^https://"
            }
          ]
        },
        "seniority": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "string",
              "enum": [
                "owner",
                "c_suite",
                "vp",
                "director",
                "manager",
                "senior",
                "individual_contributor"
              ]
            }
          ]
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "display_name",
        "first_name",
        "last_name",
        "observed_at_ms",
        "profile_url"
      ],
      "properties": {
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "\\S"
        },
        "first_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "\\S"
        },
        "last_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "\\S"
        },
        "observed_at_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "profile_url": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "string",
              "format": "uri",
              "maxLength": 2048,
              "pattern": "^https://"
            }
          ]
        }
      }
    },
    "providerIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_key", "provider_subject_id"],
      "properties": {
        "provider_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9._-]*$"
        },
        "provider_subject_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "\\S"
        }
      }
    },
    "resolveContact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate",
        "identity",
        "provider_identity",
        "source_record_id"
      ],
      "properties": {
        "candidate": { "$ref": "#/$defs/candidate" },
        "identity": { "$ref": "#/$defs/identity" },
        "provider_identity": { "$ref": "#/$defs/providerIdentity" },
        "source_record_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "\\S"
        }
      }
    },
    "resolveSelection": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/resolveContact" }
    },
    "verifyContact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate",
        "identity",
        "provider_identity",
        "source_record_id",
        "work_email"
      ],
      "properties": {
        "candidate": { "$ref": "#/$defs/candidate" },
        "identity": { "$ref": "#/$defs/identity" },
        "provider_identity": { "$ref": "#/$defs/providerIdentity" },
        "source_record_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "\\S"
        },
        "work_email": { "$ref": "#/$defs/workEmail" }
      }
    },
    "verifySelection": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/verifyContact" }
    },
    "workEmail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confidence",
        "email",
        "observed_at_ms",
        "source",
        "verification"
      ],
      "properties": {
        "confidence": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 320,
          "pattern": "^[^@\\s]+@[^@\\s]+$"
        },
        "observed_at_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "source": { "type": "string", "enum": ["provider_unspecified"] },
        "verification": {
          "type": "string",
          "enum": ["valid", "accept_all", "invalid", "unknown"]
        }
      }
    }
  },
  "x-kurobara-schema-version": "1.0.0",
  "x-kurobara-owner": "application.contacts",
  "x-kurobara-data-classification": "restricted",
  "x-kurobara-publication-status": "local-development-only"
}
