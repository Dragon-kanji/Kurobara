{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kurobara.invalid/schemas/datasets/import-response/1.0.0",
  "title": "DatasetsImportResponse",
  "description": "Stable completed import progress returned for a first application or exact replay.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workspace_id",
    "dataset_id",
    "import_id",
    "state",
    "batch_count",
    "item_count",
    "record_count",
    "error_count",
    "replayed"
  ],
  "properties": {
    "workspace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "\\S"
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "\\S"
    },
    "import_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "\\S"
    },
    "state": {
      "const": "completed"
    },
    "batch_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "item_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "record_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "error_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "replayed": {
      "type": "boolean"
    }
  },
  "x-kurobara-schema-version": "1.0.0",
  "x-kurobara-owner": "application.datasets",
  "x-kurobara-data-classification": "internal",
  "x-kurobara-publication-status": "local-development-only"
}
