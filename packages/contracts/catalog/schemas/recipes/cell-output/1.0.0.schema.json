{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kurobara.invalid/schemas/recipes/cell-output/1.0.0",
  "title": "RecipeCellOutput",
  "description": "Canonical internal camelCase envelope for one normalized recipe sink output before projection to CellResult.",
  "type": "object",
  "additionalProperties": false,
  "required": ["value"],
  "properties": {
    "value": { "$ref": "#/$defs/scalar" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["references"],
      "properties": {
        "references": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          }
        }
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observedAt"],
      "properties": {
        "observedAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expiresAt": {
          "description": "When present, application validation also requires expiresAt to be greater than or equal to observedAt.",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  },
  "$defs": {
    "scalar": {
      "description": "Bounded scalar output; null is explicit and nested arrays and objects are rejected.",
      "oneOf": [
        { "type": "string", "maxLength": 16384 },
        {
          "type": "number",
          "minimum": -1000000000000000,
          "maximum": 1000000000000000
        },
        { "type": "boolean" },
        { "type": "null" }
      ]
    }
  },
  "x-kurobara-schema-version": "1.0.0",
  "x-kurobara-owner": "application.recipes",
  "x-kurobara-data-classification": "confidential",
  "x-kurobara-publication-status": "local-development-only"
}
