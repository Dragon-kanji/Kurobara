{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kurobara.invalid/schemas/contacts/contact-candidate/1.0.0",
  "title": "ContactCandidate",
  "description": "Provider-neutral professional identity produced without exposing email, phone, or provider identifiers.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contact_id",
    "department",
    "display_name",
    "identity_completeness",
    "job_title",
    "observed_at_ms",
    "organization_domain",
    "organization_id",
    "organization_name",
    "person_country_code",
    "profile_url",
    "seniority"
  ],
  "properties": {
    "contact_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "\\S"
    },
    "department": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9._-]*$"
        }
      ]
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "\\S"
    },
    "identity_completeness": {
      "type": "string",
      "enum": ["full", "obfuscated"]
    },
    "job_title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "\\S"
    },
    "observed_at_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "organization_domain": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
    },
    "organization_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "\\S"
    },
    "organization_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "\\S"
    },
    "person_country_code": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "string",
          "minLength": 2,
          "maxLength": 2,
          "pattern": "^[A-Z]{2}$"
        }
      ]
    },
    "profile_url": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "string",
          "format": "uri",
          "maxLength": 2048,
          "pattern": "^https://"
        }
      ]
    },
    "seniority": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "string",
          "enum": [
            "owner",
            "c_suite",
            "vp",
            "director",
            "manager",
            "senior",
            "individual_contributor"
          ]
        }
      ]
    }
  },
  "x-kurobara-schema-version": "1.0.0",
  "x-kurobara-owner": "kernel.contacts",
  "x-kurobara-data-classification": "confidential",
  "x-kurobara-publication-status": "local-development-only"
}
