{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kurobara.invalid/schemas/plugins/manifest/1.0.0",
  "title": "PluginManifest",
  "description": "Local-development contract for declaring a Kurobara plugin without granting runtime authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "id",
    "version",
    "capabilities",
    "auth",
    "execution",
    "economics",
    "permissions"
  ],
  "properties": {
    "apiVersion": { "const": "dev.kurobara.plugin/v1" },
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9-]*)+$"
    },
    "version": { "$ref": "#/$defs/semver" },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/capability" }
    },
    "auth": { "$ref": "#/$defs/auth" },
    "execution": { "$ref": "#/$defs/execution" },
    "economics": { "$ref": "#/$defs/economics" },
    "permissions": { "$ref": "#/$defs/permissions" }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "contract_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalogVersion",
        "catalogFingerprint",
        "schemaId",
        "schemaVersion",
        "schemaFingerprint"
      ],
      "properties": {
        "catalogVersion": { "$ref": "#/$defs/semver" },
        "catalogFingerprint": { "$ref": "#/$defs/content_hash" },
        "schemaId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^https://schemas\\.kurobara\\.invalid/schemas/[a-z0-9-]+/[a-z0-9-]+/[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "schemaVersion": { "$ref": "#/$defs/semver" },
        "schemaFingerprint": { "$ref": "#/$defs/content_hash" }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capabilityId",
        "capabilityVersion",
        "inputContract",
        "outputContract"
      ],
      "properties": {
        "capabilityId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z][a-z0-9-]*)+$"
        },
        "capabilityVersion": { "$ref": "#/$defs/semver" },
        "inputContract": { "$ref": "#/$defs/contract_ref" },
        "outputContract": { "$ref": "#/$defs/contract_ref" }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modes"],
      "properties": {
        "modes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "none",
              "api-key-header",
              "bearer-token",
              "oauth2-client-credentials"
            ]
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["idempotency", "lookup", "timeouts"],
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "idempotency": {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode", "keyScope"],
              "properties": {
                "mode": { "const": "none" },
                "keyScope": { "const": "operation" }
              }
            },
            "lookup": {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode", "authoritativeNotFound"],
              "properties": {
                "mode": { "const": "none" },
                "authoritativeNotFound": { "const": false }
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "idempotency": {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode", "keyScope"],
              "properties": {
                "mode": { "enum": ["native-key", "lookup-only"] },
                "keyScope": { "const": "operation" }
              }
            },
            "lookup": {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode", "authoritativeNotFound"],
              "properties": {
                "mode": {
                  "enum": ["by-operation-key", "by-external-operation-id"]
                },
                "authoritativeNotFound": { "type": "boolean" }
              }
            }
          }
        }
      ],
      "properties": {
        "idempotency": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "keyScope"],
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["native-key", "lookup-only", "none"]
            },
            "keyScope": { "const": "operation" }
          }
        },
        "lookup": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "authoritativeNotFound"],
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["by-operation-key", "by-external-operation-id", "none"]
            },
            "authoritativeNotFound": { "type": "boolean" }
          }
        },
        "timeouts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["executeMs", "lookupMs"],
          "properties": {
            "executeMs": {
              "type": "integer",
              "minimum": 100,
              "maximum": 300000
            },
            "lookupMs": {
              "type": "integer",
              "minimum": 100,
              "maximum": 150000
            }
          }
        }
      }
    },
    "economics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["estimateGuarantee", "usageReporting", "unit"],
      "properties": {
        "estimateGuarantee": {
          "type": "string",
          "enum": ["hard", "estimated", "unknown"]
        },
        "usageReporting": {
          "type": "string",
          "enum": ["exact", "estimated", "unavailable"]
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9._-]*$"
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["egress"],
      "properties": {
        "egress": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hosts", "tlsRequired"],
          "properties": {
            "hosts": {
              "type": "array",
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 3,
                "maxLength": 253,
                "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z][a-z0-9-]{1,62}$"
              }
            },
            "tlsRequired": { "const": true }
          }
        }
      }
    }
  },
  "x-kurobara-schema-version": "1.0.0",
  "x-kurobara-owner": "plugin-sdk",
  "x-kurobara-data-classification": "internal",
  "x-kurobara-publication-status": "local-development-only"
}
