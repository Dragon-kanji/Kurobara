{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kurobara.invalid/schemas/contacts/selected-contact-derived-dataset-request/1.0.0",
  "title": "SelectedContactDerivedDatasetRequest",
  "description": "Provider-neutral command that derives one immutable contact dataset from an ordered selection of one to three source records.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "authority_envelope_id",
    "budget",
    "contact_dataset_id",
    "contact_record_ids",
    "deadline_ms",
    "operation_id"
  ],
  "properties": {
    "authority_envelope_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "\\S"
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["limit", "unit"],
      "properties": {
        "limit": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000000000000
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9._-]*$"
        }
      }
    },
    "contact_dataset_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "\\S"
    },
    "contact_record_ids": {
      "description": "Ordered immutable source selection. The derived dataset preserves this order and cardinality.",
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 255,
        "pattern": "\\S"
      }
    },
    "deadline_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "operation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "\\S"
    }
  },
  "x-kurobara-schema-version": "1.0.0",
  "x-kurobara-owner": "application.contacts",
  "x-kurobara-data-classification": "confidential",
  "x-kurobara-publication-status": "local-development-only"
}
