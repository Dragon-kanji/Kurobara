{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kurobara.invalid/schemas/contacts/discover-request/1.0.0",
  "title": "ContactsDiscoverRequest",
  "description": "Zero-effect dry-run or bounded start command for a contact shortlist linked to one organization generation or imported dataset.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "authority_envelope_id",
    "budget",
    "dataset_id",
    "dataset_name",
    "deadline_ms",
    "discovery_id",
    "limits",
    "mode",
    "query"
  ],
  "properties": {
    "authority_envelope_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "\\S"
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["limit", "unit"],
      "properties": {
        "limit": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000000000000
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9._-]*$"
        }
      }
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "\\S"
    },
    "dataset_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "\\S"
    },
    "deadline_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "discovery_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "\\S"
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_calls",
        "max_companies",
        "max_contacts_per_company",
        "max_contacts_total",
        "max_pages"
      ],
      "properties": {
        "max_calls": { "type": "integer", "minimum": 1, "maximum": 100 },
        "max_companies": { "type": "integer", "minimum": 1, "maximum": 10 },
        "max_contacts_per_company": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "max_contacts_total": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "max_pages": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "mode": { "type": "string", "enum": ["dry-run", "start"] },
    "organization_dataset": {
      "$ref": "https://schemas.kurobara.invalid/schemas/contacts/organization-dataset-source/1.0.0"
    },
    "organization_generation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "\\S"
    },
    "query": {
      "$ref": "https://schemas.kurobara.invalid/schemas/contacts/discovery-query/1.0.0"
    }
  },
  "oneOf": [
    {
      "type": "object",
      "required": ["organization_generation_id"],
      "properties": {
        "organization_generation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "\\S"
        },
        "organization_dataset": false
      }
    },
    {
      "type": "object",
      "required": ["organization_dataset"],
      "properties": {
        "organization_dataset": {
          "$ref": "https://schemas.kurobara.invalid/schemas/contacts/organization-dataset-source/1.0.0"
        },
        "organization_generation_id": false
      }
    }
  ],
  "x-kurobara-schema-version": "1.0.0",
  "x-kurobara-owner": "application.contacts",
  "x-kurobara-data-classification": "confidential",
  "x-kurobara-publication-status": "local-development-only"
}
