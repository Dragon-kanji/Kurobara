{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kurobara.invalid/schemas/product/field/1.0.0",
  "title": "Field",
  "description": "Provider-independent definition of one scalar dataset field.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "field_id",
    "dataset_id",
    "workspace_id",
    "key",
    "label",
    "value_type"
  ],
  "properties": {
    "field_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "\\S"
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "\\S"
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "\\S"
    },
    "key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "\\S"
    },
    "value_type": {
      "type": "string",
      "enum": ["string", "number", "boolean"]
    }
  },
  "x-kurobara-schema-version": "1.0.0",
  "x-kurobara-owner": "product.datasets",
  "x-kurobara-data-classification": "internal",
  "x-kurobara-publication-status": "local-development-only"
}
