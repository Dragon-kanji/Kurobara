{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kurobara.invalid/schemas/recipe-applications/export-request/1.0.0",
  "title": "RecipeApplicationsExportRequest",
  "description": "Selects one exact durable recipe application projection for a bounded streamed CSV or JSONL download.",
  "type": "object",
  "additionalProperties": false,
  "required": ["application_id", "format"],
  "properties": {
    "application_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "\\S"
    },
    "format": {
      "type": "string",
      "enum": ["csv", "jsonl"]
    },
    "field_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 255,
        "pattern": "\\S"
      }
    }
  },
  "x-kurobara-schema-version": "1.0.0",
  "x-kurobara-owner": "application.recipe-applications",
  "x-kurobara-data-classification": "confidential",
  "x-kurobara-publication-status": "local-development-only"
}
