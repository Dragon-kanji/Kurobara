{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kurobara.invalid/schemas/datasets/export-request/1.0.0",
  "title": "DatasetsExportRequest",
  "description": "Selects one exact ready dataset for a bounded deterministic CSV or JSONL stream.",
  "type": "object",
  "additionalProperties": false,
  "required": ["dataset_id", "format"],
  "properties": {
    "dataset_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "\\S"
    },
    "field_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 255,
        "pattern": "\\S"
      }
    },
    "format": { "type": "string", "enum": ["csv", "jsonl"] }
  },
  "x-kurobara-schema-version": "1.0.0",
  "x-kurobara-owner": "application.datasets",
  "x-kurobara-data-classification": "confidential",
  "x-kurobara-publication-status": "local-development-only"
}
