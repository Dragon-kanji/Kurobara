{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kurobara.invalid/schemas/runs/cancel-response/1.0.0",
  "title": "RunsCancelResponse",
  "description": "Canonical run snapshot after a stop request, including command replay information.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "run_plan_id",
    "workspace_id",
    "state",
    "aggregate_version",
    "event_sequence",
    "result_completeness",
    "created_at_ms",
    "replayed"
  ],
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "run_plan_id": { "type": "string", "minLength": 1 },
    "workspace_id": { "type": "string", "minLength": 1 },
    "state": {
      "description": "Fresh cancellations return cancelling, ambiguous, or cancelled. An exact replay returns the current durable snapshot, which may have reconciled to completed or failed.",
      "type": "string",
      "enum": ["cancelling", "ambiguous", "cancelled", "completed", "failed"]
    },
    "aggregate_version": { "type": "integer", "minimum": 1 },
    "event_sequence": { "type": "integer", "minimum": 1 },
    "result_completeness": {
      "type": "string",
      "enum": ["none", "partial", "complete"]
    },
    "created_at_ms": { "type": "integer", "minimum": 0 },
    "replayed": { "type": "boolean" }
  },
  "x-kurobara-schema-version": "1.0.0",
  "x-kurobara-owner": "application.runs",
  "x-kurobara-data-classification": "internal",
  "x-kurobara-publication-status": "local-development-only"
}
