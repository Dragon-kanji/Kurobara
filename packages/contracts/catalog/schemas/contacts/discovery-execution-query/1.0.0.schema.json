{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kurobara.invalid/schemas/contacts/discovery-execution-query/1.0.0",
  "title": "ContactDiscoveryExecutionQuery",
  "description": "Internal normalized contact-discovery query with the ordered parent company snapshot in dataset ordinal order; contact details and provider lineage are intentionally absent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "company_headquarters_country_codes",
    "departments",
    "organization_source",
    "organizations",
    "person_country_codes",
    "result_kind",
    "seniorities",
    "titles"
  ],
  "properties": {
    "company_headquarters_country_codes": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 2,
        "pattern": "^[A-Z]{2}$"
      }
    },
    "departments": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[a-z][a-z0-9._-]*$"
      }
    },
    "organization_source": {
      "$ref": "https://schemas.kurobara.invalid/schemas/contacts/organization-source-lineage/1.0.0"
    },
    "organizations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["company_id", "country_code", "domain", "name"],
        "properties": {
          "company_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "\\S"
          },
          "country_code": {
            "type": "string",
            "minLength": 2,
            "maxLength": 2,
            "pattern": "^[A-Z]{2}$"
          },
          "domain": {
            "type": ["string", "null"],
            "minLength": 1,
            "maxLength": 253,
            "pattern": "^[A-Za-z0-9.-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "\\S"
          }
        }
      }
    },
    "person_country_codes": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 2,
        "pattern": "^[A-Z]{2}$"
      }
    },
    "result_kind": { "type": "string", "const": "contact" },
    "seniorities": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "owner",
          "c_suite",
          "vp",
          "director",
          "manager",
          "senior",
          "individual_contributor"
        ]
      }
    },
    "titles": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "\\S"
      }
    }
  },
  "x-kurobara-schema-version": "1.0.0",
  "x-kurobara-owner": "application.contacts",
  "x-kurobara-data-classification": "confidential",
  "x-kurobara-publication-status": "local-development-only"
}
