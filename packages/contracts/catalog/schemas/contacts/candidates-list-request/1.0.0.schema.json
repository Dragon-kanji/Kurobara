{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kurobara.invalid/schemas/contacts/candidates-list-request/1.0.0",
  "title": "ContactsCandidatesListRequest",
  "description": "Bounded keyset request for one page of ready contact candidates.",
  "type": "object",
  "additionalProperties": false,
  "required": ["generation_id", "limit"],
  "properties": {
    "generation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "\\S"
    },
    "after_ordinal": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    }
  },
  "x-kurobara-schema-version": "1.0.0",
  "x-kurobara-owner": "application.contacts",
  "x-kurobara-data-classification": "confidential",
  "x-kurobara-publication-status": "local-development-only"
}
