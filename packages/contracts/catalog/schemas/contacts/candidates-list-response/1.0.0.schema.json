{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kurobara.invalid/schemas/contacts/candidates-list-response/1.0.0",
  "title": "ContactsCandidatesListResponse",
  "description": "Privacy-safe provider-neutral keyset page from one immutable ready contact materialization.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workspace_id",
    "generation_id",
    "dataset_id",
    "record_count",
    "provenance",
    "page",
    "items"
  ],
  "properties": {
    "workspace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "\\S"
    },
    "generation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "\\S"
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "\\S"
    },
    "record_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_id",
        "capability_version",
        "generation_plan_id",
        "plan_hash",
        "query_hash",
        "schema_hash",
        "materialization_id",
        "materialization_revision",
        "materialization_content_hash",
        "completed_at_ms",
        "completion_reason",
        "coverage"
      ],
      "properties": {
        "capability_id": {
          "type": "string",
          "const": "contacts.discover"
        },
        "capability_version": {
          "type": "string",
          "const": "1.0.0"
        },
        "generation_plan_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "\\S"
        },
        "plan_hash": {
          "type": "string",
          "minLength": 71,
          "maxLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "query_hash": {
          "type": "string",
          "minLength": 71,
          "maxLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "schema_hash": {
          "type": "string",
          "minLength": 71,
          "maxLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "materialization_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "\\S"
        },
        "materialization_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "materialization_content_hash": {
          "type": "string",
          "minLength": 71,
          "maxLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "completed_at_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "completion_reason": {
          "type": "string",
          "enum": ["caps-reached", "source-completed"]
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["basis", "status"],
          "properties": {
            "basis": {
              "type": "string",
              "const": "locked_provider_route"
            },
            "status": {
              "type": "string",
              "enum": ["bounded", "complete_for_declared_source"]
            }
          }
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["after_ordinal", "limit", "has_more", "next_after_ordinal"],
      "properties": {
        "after_ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "has_more": { "type": "boolean" },
        "next_after_ordinal": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "items": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ordinal", "candidate"],
        "properties": {
          "ordinal": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "candidate": {
            "$ref": "https://schemas.kurobara.invalid/schemas/contacts/contact-candidate/1.0.0"
          }
        }
      }
    }
  },
  "x-kurobara-schema-version": "1.0.0",
  "x-kurobara-owner": "application.contacts",
  "x-kurobara-data-classification": "confidential",
  "x-kurobara-publication-status": "local-development-only"
}
